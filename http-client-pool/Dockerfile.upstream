FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY http-client-pool/upstream ./http-client-pool/upstream
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/upstream ./http-client-pool/upstream

FROM alpine:3.21
RUN addgroup -S app && adduser -S -G app app
COPY --from=build /out/upstream /upstream
USER app:app
EXPOSE 8081
ENTRYPOINT ["/upstream"]